<UserControl x:Class="QuanLyThuVien.Views.UCQuanLySach"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyThuVien.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="THÔNG TIN SÁCH" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,16"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="300" VerticalAlignment="Top">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Tên cuốn sách (*)" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding TenSach, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" ToolTip="Nhập tên sách"/>

                        <TextBlock Text="Tác giả" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding TacGia, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>

                        <!-- Tạm dùng TextBox cho Mã Loại, thực tế nên dùng ComboBox trỏ tới ListLoaiSach -->
                        <TextBlock Text="Mã loại sách" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding MaLoai, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số lượng tồn" Style="{StaticResource LabelTextStyle}"/>
                                <TextBox Text="{Binding SoLuongTon, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Năm xuất bản" Style="{StaticResource LabelTextStyle}"/>
                                <TextBox Text="{Binding NamXB, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- CÁC NÚT TƯƠNG TÁC -->
                <UniformGrid Grid.Row="2" Columns="2" Rows="2" Margin="0,24,4,0">
                    <!-- Nút Làm Mới -->
                    <Button Command="{Binding ClearCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,6,12" Height="42">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" Margin="0,0,8,0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Thêm Mới -->
                    <Button Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,12" Height="42">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✚" Margin="0,0,8,0" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Thêm mới" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Sửa/Cập nhật -->
                    <Button Command="{Binding EditCommand}" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,6,0" Height="42">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✎" Margin="0,0,8,0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Cập nhật" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Xóa -->
                    <Button Command="{Binding DeleteCommand}" Style="{StaticResource DangerButtonStyle}" Margin="6,0,0,0" Height="42">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✖" Margin="0,0,8,0" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Xóa bỏ" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- CỘT PHẢI: DANH SÁCH -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="DANH SÁCH TÀI LIỆU" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding ListSach}" SelectedItem="{Binding SelectedSach}" Style="{StaticResource AppDataGridStyle}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Sách" Binding="{Binding MaSach}" Width="80"/>
                        <DataGridTextColumn Header="Tên Sách" Binding="{Binding TenSach}" Width="*"/>
                        <DataGridTextColumn Header="Tác Giả" Binding="{Binding TacGia}" Width="150"/>
                        <DataGridTextColumn Header="Loại" Binding="{Binding MaLoai}" Width="80"/>
                        <DataGridTextColumn Header="Tồn Kho" Binding="{Binding SoLuongTon}" Width="80"/>
                        <DataGridTextColumn Header="Năm XB" Binding="{Binding NamXB}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
