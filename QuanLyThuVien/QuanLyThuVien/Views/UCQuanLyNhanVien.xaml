<UserControl x:Class="QuanLyThuVien.Views.UCQuanLyNhanVien"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyThuVien.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: FORM NHẬP LIỆU -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="HỒ SƠ NHÂN VIÊN" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,16"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Họ và tên (*)" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>

                        <TextBlock Text="Tên đăng nhập (*)" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding TenDN, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>

                        <TextBlock Text="Mật khẩu" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding MatKhau, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>

                        <TextBlock Text="Phân quyền (Vai trò)" Style="{StaticResource LabelTextStyle}"/>
                        <ComboBox SelectedValue="{Binding Quyen, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource AppComboBoxStyle}">
                            <ComboBoxItem Content="Admin"/>
                            <ComboBoxItem Content="ThuThu"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- CÁC NÚT TƯƠNG TÁC (UniformGrid 2x2) -->
                <UniformGrid Grid.Row="2" Columns="2" Rows="2" Margin="0,24,4,0">
                    <!-- Nút Làm Mới -->
                    <Button Command="{Binding ClearCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,6,12" Height="42">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" Margin="0,0,8,0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Thêm Mới -->
                    <Button Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,12" Height="42">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✚" Margin="0,0,8,0" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Thêm mới" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Sửa/Cập nhật -->
                    <Button Command="{Binding EditCommand}" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,6,0" Height="42">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✎" Margin="0,0,8,0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Cập nhật" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Xóa -->
                    <Button Command="{Binding DeleteCommand}" Style="{StaticResource DangerButtonStyle}" Margin="6,0,0,0" Height="42">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✖" Margin="0,0,8,0" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Xóa bỏ" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- CỘT PHẢI: DANH SÁCH -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="DANH SÁCH NHÂN SỰ" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding ListNhanVien}" SelectedItem="{Binding SelectedNhanVien}" Style="{StaticResource AppDataGridStyle}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã NV" Binding="{Binding MaNV}" Width="70"/>
                        <DataGridTextColumn Header="Họ Tên" Binding="{Binding HoTen}" Width="*"/>
                        <DataGridTextColumn Header="Tên Đăng Nhập" Binding="{Binding TenDN}" Width="150"/>
                        <!-- Mật khẩu thường không hiển thị trực tiếp trên DataGrid để bảo mật, 
                             nhưng nếu muốn hiển thị cho mục đích làm đồ án, bạn có thể uncomment dòng dưới -->
                        <!-- <DataGridTextColumn Header="Mật Khẩu" Binding="{Binding MatKhau}" Width="100"/> -->
                        <DataGridTextColumn Header="Vai Trò" Binding="{Binding Quyen}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
