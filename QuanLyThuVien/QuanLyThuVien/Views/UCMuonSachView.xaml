<UserControl x:Class="QuanLyThuVien.Views.UCMuonSachView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyThuVien.Views"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1150">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="NGHIỆP VỤ MƯỢN SÁCH" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,20"/>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,16,16,4" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Tìm kiếm (Mã phiếu, Mã ĐG, Mã BS)" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource AppTextBoxStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="TÌM KIẾM" 
                            Command="{Binding SearchCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Margin="0,10,0,0" Width="100"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding ListDangMuon}" 
                          Style="{StaticResource AppDataGridStyle}" Margin="1"
                          SelectedItem="{Binding SelectedPhieu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Phiếu" Binding="{Binding MaPhieu}" Width="80"/>
                        <DataGridTextColumn Header="Mã ĐG" Binding="{Binding MaDG}" Width="80"/>
                        <DataGridTextColumn Header="Mã BS" Binding="{Binding MaBS}" Width="80"/>
                        <DataGridTextColumn Header="Tên Sách" Binding="{Binding TenSach}" Width="*"/>
                        <DataGridTextColumn Header="Ngày Mượn" Binding="{Binding NgayMuon, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                        <DataGridTextColumn Header="Hạn Trả" Binding="{Binding HanTra, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                        <DataGridTextColumn Header="Nhân Viên" Binding="{Binding MaNV}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource HighlightCardStyle}" VerticalAlignment="Bottom">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" Margin="0,0,-8,0">
                <StackPanel>
                    <TextBlock Text="THÔNG TIN PHIẾU MƯỢN" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,24"/>

                    <Border Background="{DynamicResource Brush.Card}" CornerRadius="{StaticResource Radius.Small}" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="1. Thông tin chung" FontWeight="Bold" Foreground="{DynamicResource Brush.PrimaryDark}" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Mã Phiếu (VD: PM051)" Style="{StaticResource LabelTextStyle}"/>
                                    <TextBox Text="{Binding MaPhieu, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Số ngày mượn" Style="{StaticResource LabelTextStyle}"/>
                                    <TextBox Text="{Binding SoNgayMuon, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Mã Độc Giả" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding MaDG, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>

                            <TextBlock Text="{Binding TenDocGiaGoiY}" 
                                       Style="{StaticResource CaptionTextStyle}" 
                                       Foreground="{DynamicResource Brush.Success}" 
                                       FontWeight="SemiBold"
                                       Visibility="{Binding HasDocGia, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Margin="4,-8,0,8"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Brush.Card}" CornerRadius="{StaticResource Radius.Small}" Padding="12" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="2. Thêm sách vào phiếu" FontWeight="Bold" Foreground="{DynamicResource Brush.PrimaryDark}" Margin="0,0,0,12"/>

                            <TextBlock Text="Mã Bản Sao (Quét mã vạch/Nhập)" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding MaBS, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>

                            <TextBlock Text="{Binding TenSachGoiY}" 
                                       Style="{StaticResource CaptionTextStyle}" 
                                       Foreground="{DynamicResource Brush.TextSecondary}" 
                                       FontWeight="SemiBold"
                                       Visibility="{Binding HasSach, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Margin="4,-8,0,8"/>
                        </StackPanel>
                    </Border>
                    <Separator Margin="0,16,0,24" Background="{DynamicResource Brush.BorderSoft}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Content="✚ THÊM MỚI" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0 0 10 0"/>

                        <Button Grid.Row="0" Grid.Column="1" Content="✎ SỬA" Command="{Binding UpdateCommand}" Style="{StaticResource SuccessButtonStyle}" Margin="0 0 10 0"/>

                        <Button Grid.Row="1" Grid.Column="0" Content="✖ XÓA" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0 10 10 0" />

                        <Button Grid.Row="1" Grid.Column="1" Content="↻ LÀM MỚI" Command="{Binding ClearCommand}" Style="{StaticResource BaseButtonStyle}" Margin="0 10 10 0"/>
                    </Grid>


                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource Brush.Danger}" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
