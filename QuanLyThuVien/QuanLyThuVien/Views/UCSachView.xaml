<UserControl x:Class="QuanLyThuVien.Views.UCSachView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyThuVien.Views"
             mc:Ignorable="d" 
            d:DesignHeight="750" d:DesignWidth="1200">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="QUẢN LÝ KHO SÁCH" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,20"/>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,16,16,4" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Tìm kiếm theo mã sách hoặc tên sách" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource AppTextBoxStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="TÌM KIẾM" 
                            Command="{Binding SearchCommand}" 
                            Style="{StaticResource BaseButtonStyle}" 
                            Margin="0,2,0,12" Width="100"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding ListSach}" 
                          SelectedItem="{Binding SelectedSach}"
                          Style="{StaticResource AppDataGridStyle}" Margin="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Sách" Binding="{Binding MaSach}" Width="80"/>
                        <DataGridTextColumn Header="Tên Đầu Sách" Binding="{Binding TenSach}" Width="*"/>
                        <DataGridTextColumn Header="Nhà Xuất Bản" Binding="{Binding NhaXuatBan.TenNXB}" Width="150"/>
                        <DataGridTextColumn Header="Năm XB" Binding="{Binding NamXB}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Bottom">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" Margin="0,0,-8,0">
                <StackPanel>
                    <TextBlock Text="THÔNG TIN ĐẦU SÁCH" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,24"/>

                    <TextBlock Text="Mã sách" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Text="{Binding MaSach, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource AppTextBoxStyle}" IsEnabled="{Binding IsEditingMode}"/>

                    <TextBlock Text="Tên sách" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Text="{Binding TenSach, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource AppTextBoxStyle}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>

                    <TextBlock Text="Nhà xuất bản" Style="{StaticResource LabelTextStyle}"/>
                    <ComboBox ItemsSource="{Binding ListNXB}" 
                              DisplayMemberPath="TenNXB" 
                              SelectedValuePath="MaNXB"
                              SelectedValue="{Binding SelectedMaNXB}"
                              Style="{StaticResource AppComboBoxStyle}"/>

                    <TextBlock Text="Năm xuất bản" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Text="{Binding NamXB, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>

                    <Separator Margin="0,16,0,24" Background="{DynamicResource Brush.BorderSoft}"/>

                    <TextBlock Text="Lưu ý: Thể loại và Tác giả được quản lý trong mục Chi tiết." 
                               Style="{StaticResource CaptionTextStyle}" FontStyle="Italic" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Content="THÊM MỚI" 
                                Command="{Binding AddCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}"/>

                        <Button Grid.Row="0" Grid.Column="1" Content="LƯU SỬA" 
                                Command="{Binding UpdateCommand}" 
                                Style="{StaticResource SuccessButtonStyle}" Margin="0"/>

                        <Button Grid.Row="1" Grid.ColumnSpan="2" Content="XÓA ĐẦU SÁCH" 
                                Command="{Binding DeleteCommand}" 
                                Style="{StaticResource DangerButtonStyle}" Margin="0,12,0,0"/>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}" 
                               Style="{StaticResource BodyTextStyle}" 
                               Foreground="{DynamicResource Brush.PrimaryDark}" 
                               FontWeight="SemiBold" TextAlignment="Center" Margin="0,20,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
