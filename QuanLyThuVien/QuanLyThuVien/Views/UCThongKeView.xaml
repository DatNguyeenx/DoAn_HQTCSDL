<UserControl x:Class="QuanLyThuVien.Views.UCThongKeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyThuVien.Views"
             mc:Ignorable="d" 
            d:DesignHeight="750" d:DesignWidth="1150">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="BÁO CÁO THỐNG KÊ" Style="{StaticResource TitleTextStyle}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="🔄 LÀM MỚI DỮ LIỆU" 
                        Command="{Binding RefreshCommand}" 
                        Style="{StaticResource BaseButtonStyle}" Width="150"/>
                <Button Content="📥 XUẤT BÁO CÁO" 
                        Command="{Binding ExportCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" Width="150" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Rows="1" Margin="0,0,0,20">

            <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="TỔNG SỐ ĐẦU SÁCH" Style="{StaticResource CaptionTextStyle}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TongDauSach, FallbackValue='0'}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Brush.PrimaryDark}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="BẢN SAO SẴN SÀNG" Style="{StaticResource CaptionTextStyle}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TongSanSang, FallbackValue='0'}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="SÁCH ĐANG ĐƯỢC MƯỢN" Style="{StaticResource CaptionTextStyle}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TongDangMuon, FallbackValue='0'}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0" Padding="20" Background="{DynamicResource Brush.ChartCardBackground}" BorderBrush="{DynamicResource Brush.ChartCardBorder}">
                <StackPanel>
                    <TextBlock Text="ĐỘC GIẢ NỢ QUÁ HẠN" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource Brush.ChartTitle}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TongNoQuaHan, FallbackValue='0'}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Brush.Danger}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource Brush.PrimaryLight}" Padding="16,12" CornerRadius="16,16,0,0">
                        <TextBlock Text="THỐNG KÊ SỐ LƯỢNG THEO ĐẦU SÁCH (View: v_ThongKeSach)" 
                                   Style="{StaticResource SectionTitleTextStyle}" Foreground="{DynamicResource Brush.PrimaryDark}"/>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ListThongKeSach}" 
                              Style="{StaticResource AppDataGridStyle}" Margin="1,0,1,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Sách" Binding="{Binding MaSach}" Width="80"/>
                            <DataGridTextColumn Header="Tên Sách" Binding="{Binding TenSach}" Width="*"/>
                            <DataGridTextColumn Header="Các Thể Loại" Binding="{Binding CacTheLoai}" Width="150"/>
                            <DataGridTextColumn Header="SL Sẵn Sàng" Binding="{Binding SoLuongSanSang}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource Brush.DangerSoft}" Padding="16,12" CornerRadius="16,16,0,0">
                        <TextBlock Text="DANH SÁCH NỢ QUÁ HẠN CẦN THU HỒI" 
                                   Style="{StaticResource SectionTitleTextStyle}" Foreground="{DynamicResource Brush.Danger}"/>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ListNoQuaHan}" 
                              Style="{StaticResource AppDataGridStyle}" Margin="1,0,1,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên Độc Giả" Binding="{Binding HoTen}" Width="140"/>
                            <DataGridTextColumn Header="Tên Sách Đang Nợ" Binding="{Binding TenSach}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
