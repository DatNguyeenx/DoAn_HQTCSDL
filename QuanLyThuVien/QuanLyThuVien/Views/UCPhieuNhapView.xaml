<UserControl x:Class="QuanLyThuVien.Views.UCPhieuNhapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyThuVien.Views"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1200">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="QUẢN LÝ NHẬP KHO" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,20"/>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,16,16,4" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Tìm kiếm (Mã Phiếu Nhập)" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource AppTextBoxStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="TÌM KIẾM" 
                            Command="{Binding SearchCommand}" 
                            Style="{StaticResource BaseButtonStyle}" 
                            Margin="0,2,0,12" Width="100"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding ListPhieuNhap}" 
                          SelectedItem="{Binding SelectedPhieuNhap}"
                          Style="{StaticResource AppDataGridStyle}" Margin="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Phiếu" Binding="{Binding MaPhieuNhap}" Width="80"/>
                        <DataGridTextColumn Header="Ngày Nhập" Binding="{Binding NgayNhap, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                        <DataGridTextColumn Header="Nhân Viên" Binding="{Binding MaNV}" Width="90"/>
                        <DataGridTextColumn Header="Tổng Tiền (VNĐ)" Binding="{Binding TongTien, StringFormat=\{0:N0\}}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource HighlightCardStyle}" Margin="0,0,0,20" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="THÔNG TIN PHIẾU NHẬP" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Mã phiếu nhập" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding MaPhieuNhap, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource AppTextBoxStyle}" IsEnabled="{Binding IsEditingPhieuMode}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Ngày nhập" Style="{StaticResource LabelTextStyle}"/>
                            <DatePicker SelectedDate="{Binding NgayNhap, UpdateSourceTrigger=PropertyChanged}" 
                                        Style="{StaticResource AppDatePickerStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tổng tiền hiện tại" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding TongTien, StringFormat=\{0:N0\}}" 
                                     Style="{StaticResource AppTextBoxStyle}" IsReadOnly="True" 
                                     Foreground="{DynamicResource Brush.Danger}" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="TẠO PHIẾU MỚI" Command="{Binding AddPhieuCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0"/>
                        <Button Grid.Column="1" Content="LƯU PHIẾU" Command="{Binding SavePhieuCommand}" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,12,0" Width="100"/>
                        <Button Grid.Column="2" Content="XÓA PHIẾU" Command="{Binding DeletePhieuCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0" Width="100"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,16,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="DANH SÁCH SÁCH NHẬP KHO" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Đầu sách" Style="{StaticResource LabelTextStyle}"/>
                                <ComboBox ItemsSource="{Binding ListSach}" 
                                          DisplayMemberPath="TenSach" 
                                          SelectedValuePath="MaSach"
                                          SelectedValue="{Binding SelectedMaSach}"
                                          Style="{StaticResource AppComboBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Số lượng" Style="{StaticResource LabelTextStyle}"/>
                                <TextBox Text="{Binding SoLuong, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource AppTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Đơn giá (VNĐ)" Style="{StaticResource LabelTextStyle}"/>
                                <TextBox Text="{Binding DonGia, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource AppTextBoxStyle}"/>
                            </StackPanel>

                            <Button Grid.Column="3" Content="THÊM SÁCH" 
                                    Command="{Binding AddChiTietCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Margin="0,22,0,12" Height="38"/>
                        </Grid>

                        <TextBlock Text="{Binding ChiTietStatusMessage}" 
                                   Style="{StaticResource CaptionTextStyle}" 
                                   Foreground="{DynamicResource Brush.Danger}" 
                                   FontWeight="SemiBold" Margin="0,-4,0,12"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ListChiTietPhieu}" 
                              SelectedItem="{Binding SelectedChiTiet}"
                              Style="{StaticResource AppDataGridStyle}" Margin="1,0,1,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Sách" Binding="{Binding MaSach}" Width="80"/>
                            <DataGridTextColumn Header="Tên Sách" Binding="{Binding TenSach}" Width="*"/>
                            <DataGridTextColumn Header="Số Lượng" Binding="{Binding SoLuong}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Đơn Giá" Binding="{Binding DonGia, StringFormat=\{0:N0\}}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Thành Tiền" Binding="{Binding ThanhTien, StringFormat=\{0:N0\}}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,10,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryDark}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Xóa khỏi phiếu" Command="{Binding DeleteChiTietCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
