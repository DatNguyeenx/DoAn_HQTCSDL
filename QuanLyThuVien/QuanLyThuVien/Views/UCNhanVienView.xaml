<UserControl x:Class="QuanLyThuVien.Views.UCNhanVienView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyThuVien.Views"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1150">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="QUẢN LÝ NHÂN SỰ &amp; TÀI KHOẢN" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,20"/>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,16,16,4" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Tìm kiếm (Mã NV, Tên, Tên ĐN)" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource AppTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Chức vụ" Style="{StaticResource LabelTextStyle}"/>
                        <ComboBox SelectedItem="{Binding FilterChucVu}" Style="{StaticResource AppComboBoxStyle}">
                            <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                            <ComboBoxItem Content="Quản lý"/>
                            <ComboBoxItem Content="Thủ thư"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Column="2" Content="TÌM KIẾM" 
                            Command="{Binding SearchCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Margin="0,2,0,12" Width="100"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding ListNhanVien}" 
                          SelectedItem="{Binding SelectedNhanVien}"
                          Style="{StaticResource AppDataGridStyle}" Margin="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã NV" Binding="{Binding MaNV}" Width="80"/>
                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding HoTen}" Width="*"/>
                        <DataGridTextColumn Header="Tên Đăng Nhập" Binding="{Binding TenDN}" Width="150"/>
                        <DataGridTextColumn Header="Chức Vụ" Binding="{Binding ChucVu}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Bottom">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" Margin="0,0,-8,0">
                <StackPanel>
                    <TextBlock Text="HỒ SƠ NHÂN VIÊN" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,24"/>

                    <TextBlock Text="Mã nhân viên" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Text="{Binding MaNV, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource AppTextBoxStyle}" IsEnabled="{Binding IsEditingMode}"/>

                    <TextBlock Text="Họ và tên" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>

                    <TextBlock Text="Chức vụ" Style="{StaticResource LabelTextStyle}"/>
                    <ComboBox SelectedValue="{Binding ChucVu}" 
                              SelectedValuePath="Content"
                              Style="{StaticResource AppComboBoxStyle}">
                        <ComboBoxItem Content="Quản lý"/>
                        <ComboBoxItem Content="Thủ thư"/>
                    </ComboBox>

                    <Separator Margin="0,8,0,16" Background="{DynamicResource Brush.BorderSoft}"/>
                    <TextBlock Text="THÔNG TIN TÀI KHOẢN" Style="{StaticResource LabelTextStyle}" Foreground="{DynamicResource Brush.PrimaryDark}" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Text="Tên đăng nhập (Yêu cầu duy nhất)" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Text="{Binding TenDN, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>

                    <TextBlock Text="Mật khẩu (Nhập để tạo mới/đặt lại)" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Text="{Binding MatKhau, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>

                    <Separator Margin="0,16,0,24" Background="{DynamicResource Brush.BorderSoft}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Content="THÊM MỚI" 
                                Command="{Binding AddCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}"/>

                        <Button Grid.Row="0" Grid.Column="1" Content="LƯU SỬA" 
                                Command="{Binding UpdateCommand}" 
                                Style="{StaticResource SuccessButtonStyle}" Margin="0"/>

                        <Button Grid.Row="1" Grid.ColumnSpan="2" Content="XÓA NHÂN VIÊN" 
                                Command="{Binding DeleteCommand}" 
                                Style="{StaticResource DangerButtonStyle}" Margin="0,12,0,0"/>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}" 
                               Style="{StaticResource CaptionTextStyle}" 
                               Foreground="{DynamicResource Brush.PrimaryDark}" 
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" 
                               HorizontalAlignment="Center" 
                               Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
