<UserControl x:Class="QuanLyThuVien.Views.UCBanSaoSachView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyThuVien.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="QUẢN LÝ BẢN SAO SÁCH" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,20"/>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,16,16,4" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Tìm kiếm (Mã bản sao, Tên sách)" Style="{StaticResource LabelTextStyle}"/>
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource AppTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Lọc theo tình trạng" Style="{StaticResource LabelTextStyle}"/>
                        <ComboBox SelectedItem="{Binding FilterTinhTrang}" Style="{StaticResource AppComboBoxStyle}">
                            <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                            <ComboBoxItem Content="Sẵn sàng"/>
                            <ComboBoxItem Content="Đang mượn"/>
                            <ComboBoxItem Content="Bảo trì"/>
                            <ComboBoxItem Content="Mất"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Column="2" Content="TÌM KIẾM" 
                            Command="{Binding SearchCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Margin="0,10,0,0" Width="100"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                
                <DataGrid ItemsSource="{Binding ListBanSao}" 
                          SelectedItem="{Binding SelectedBanSao}"
                          Style="{StaticResource AppDataGridStyle}" Margin="1">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Bản Sao" Binding="{Binding MaBS}" Width="120"/>
                        <DataGridTextColumn Header="Mã Sách" Binding="{Binding MaSach}" Width="100"/>
                        <DataGridTextColumn Header="Tên Sách" Binding="{Binding TenSach}" Width="*"/>

                        <DataGridTextColumn Header="Tình Trạng" Binding="{Binding TinhTrang}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="THÔNG TIN CHI TIẾT" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,24"/>

                <TextBlock Text="Mã bản sao (Tự động hoặc nhập)" Style="{StaticResource LabelTextStyle}"/>
                <TextBox Text="{Binding MaBS, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource AppTextBoxStyle}" IsEnabled="{Binding IsEditingMode}"/>

                <TextBlock Text="Đầu sách" Style="{StaticResource LabelTextStyle}"/>
                <ComboBox ItemsSource="{Binding ListSach}" 
                          DisplayMemberPath="TenSach" 
                          SelectedValuePath="MaSach"
                          SelectedValue="{Binding SelectedMaSach}"
                          Style="{StaticResource AppComboBoxStyle}"/>

                <TextBlock Text="Tình trạng" Style="{StaticResource LabelTextStyle}"/>
                <ComboBox SelectedValue="{Binding TinhTrang}" 
                          SelectedValuePath="Content"
                          Style="{StaticResource AppComboBoxStyle}">
                    <ComboBoxItem Content="Sẵn sàng"/>
                    <ComboBoxItem Content="Đang mượn"/>
                    <ComboBoxItem Content="Bảo trì"/>
                    <ComboBoxItem Content="Mất"/>
                </ComboBox>

                <Separator Margin="0,16,0,24" Background="{DynamicResource Brush.BorderSoft}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="✚ THÊM MỚI" 
                            Command="{Binding AddCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0 0 10 0"/>

                    <Button Grid.Row="0" Grid.Column="1" Content="✎ SỬA" 
                            Command="{Binding UpdateCommand}" 
                            Style="{StaticResource SuccessButtonStyle}" Margin="0 0 10 0"/>

                    <Button Grid.Row="1" Grid.Column="0" Content="✖ XÓA" 
                            Command="{Binding DeleteCommand}" 
                            Style="{StaticResource DangerButtonStyle}" Margin="0 10 10 0"/>

                    <Button Grid.Row="1" Grid.Column="1" Content="↻ LÀM MỚI" 
                            Command="{Binding ClearCommand}" 
                            Style="{StaticResource BaseButtonStyle}" Margin="0 10 10 0"/>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}" 
                           Style="{StaticResource CaptionTextStyle}" 
                           Foreground="{DynamicResource Brush.PrimaryDark}" 
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" 
                           HorizontalAlignment="Center" 
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
